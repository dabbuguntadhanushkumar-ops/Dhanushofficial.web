        function renderEducation() {
            const container = document.getElementById('educationTimeline');
            container.innerHTML = personalData.education.map((edu, index) => `
                <div class="timeline-item animate-on-scroll delay-${index % 4}">
                    <div class="timeline-dot"></div>
                    <div class="timeline-card">
                        <span class="timeline-year">${edu.year}</span>
                        <h3 class="timeline-title">${edu.title}</h3>
                        <p class="timeline-school">${edu.school}</p>
                        <p class="timeline-desc">${edu.description}</p>
                        <div class="timeline-achievements">
                            ${edu.achievements.map(a => `<span>${a}</span>`).join('')}
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function renderSkills() {
            const container = document.getElementById('skillsGrid');
