                <div class="skill-card animate-on-scroll delay-${index % 4}">
                    <div class="skill-card-header">
                        <div class="skill-card-icon ${skill.iconClass}">${skill.icon}</div>
                        <div>
                            <h3 class="skill-card-title">${skill.category}</h3>
                            <p class="skill-card-subtitle">${skill.subtitle}</p>
                        </div>
                    </div>
                    ${skill.items.map(item => `
                        <div class="skill-item">
                            <div class="skill-item-header">
